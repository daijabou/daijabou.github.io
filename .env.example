# Two local env files, both gitignored:
#
#   .env.local              <- managed by `vercel env pull`. Do not hand-edit;
#                              it gets overwritten. Holds OPENROUTER_API_KEY.
#   .env.development.local  <- your own overrides. Higher Vite priority than
#                              .env.local, so a pull never clobbers it.

# --- Server-side, from Vercel (api/chat.ts) -------------------------------
# Never prefix with VITE_ — Vite inlines VITE_* vars into the browser bundle.
# Already set on the Vercel project; run `vercel env pull .env.local` to fetch.
OPENROUTER_API_KEY=

# Optional. Defaults to nvidia/nemotron-3-super-120b-a12b:free
MODEL=

# --- Frontend (put these in .env.development.local) -----------------------
# Deployed API URL, so the local frontend needs no local backend.
# Leave empty to use `npm run dev:api` + the /api proxy in vite.config.ts.
VITE_CHATBOT_API_URL=https://web-resume-rust.vercel.app

# Contentful Content Delivery credentials. Without them,
# src/lib/contentfulClient.ts silently falls back to hardcoded Experience data.
# app.contentful.com → Settings → API keys
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
